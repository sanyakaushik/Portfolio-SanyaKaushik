{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "sanyakaushik",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-05-26",
    "compatibility_flags": [
      "nodejs_compat"
    ],
  
    "assets": {
      "directory": ".open-next/assets",
      "binding": "ASSETS"
    },
  
    "services": [
      {
        "binding": "WORKER_SELF_REFERENCE",
        "service": "sanyakaushik"
      }
    ],
  
    "observability": {
      "enabled": true
    }
  }